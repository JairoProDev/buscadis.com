{
  "name": "buscadis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tokens:build": "npm run build --workspace=@buscadis/tokens",
    "storybook": "npx storybook dev -p 6006 -c packages/ui/.storybook",
    "build-storybook": "npx storybook build -c packages/ui/.storybook -o packages/ui/storybook-static",
    "prebuild": "npm run tokens:build",
    "postinstall": "npx update-browserslist-db@latest --quiet || true",
    "db:push": "npx supabase db push --linked --yes",
    "db:migrations": "npx supabase migration list --linked",
    "db:migrate": "node scripts/supabase-migrate.mjs",
    "search:sync-typesense": "node scripts/sync-typesense.mjs",
    "deals:seed": "node scripts/seed-deal-clips.mjs",
    "seed:buscadis": "npx tsx scripts/seed-buscadis-profile.ts",
    "demo:buscadis": "npm run seed:buscadis && npm run dev",
    "test:envios": "npx tsx scripts/test-envios-status.ts",
    "smoke:ssr": "bash scripts/smoke-ssr-indexing.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/rsc": "^3.0.2",
    "@buscadis/profile-engine": "workspace:*",
    "@buscadis/tokens": "workspace:*",
    "@buscadis/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/generative-ai": "^0.24.1",
    "@imgly/background-removal": "^1.7.0",
    "@next/third-parties": "^15.5.19",
    "@sentry/nextjs": "^10.61.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.2",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "framer-motion": "^12.23.26",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.6",
    "next": "^15.5.19",
    "next-intl": "^4.5.6",
    "onnxruntime-web": "^1.21.0",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.4",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-icons": "^5.5.0",
    "replicate": "^1.4.0",
    "resend": "^6.5.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1"
  },
  "overrides": {
    "glob": "^11.1.0",
    "jsondiffpatch": "^0.7.2",
    "postcss": "^8.5.6",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/jsdom": "^28.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.25",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-buscadis-tokens": "file:packages/tokens/eslint-rules",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.6",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
